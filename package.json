{
  "name": "dsh-personal-workbench",
  "author": "Yuze",
  "version": "0.1.0",
  "description": "个人工作台：侧栏入口（定时任务下方）+ 中央聚合面板，八个模块卡片（项目总览/待办事项/文件归档/日常管理/音乐平台/影视平台/娱乐平台/知识库）内嵌 Yuze Workbench 对应页面",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-tailwind.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "gates": "node scripts/gates.mjs",
    "smoke": "pnpm run build && pnpm run typecheck && pnpm run gates",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "lunar-typescript": "^1.8.6",
    "three": "0.186.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@formkit/auto-animate": "^0.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/three": "0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.28",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}